@host = http://localhost:5215

### Register
# @name register
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "dani@collecta.test",
  "displayName": "Dani",
  "password": "coleccion123"
}

### Login
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "dani@collecta.test",
  "password": "coleccion123"
}

### Current user (uses the token from Login)
GET {{host}}/api/auth/me
Authorization: Bearer {{login.response.body.$.accessToken}}

### Refresh (rotates: the old refresh token stops working)
# @name refresh
POST {{host}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.refreshToken}}"
}

### Logout
POST {{host}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refresh.response.body.$.refreshToken}}"
}

### Collections for the logged-in user (uses the token from Login)
# @name collections
GET {{host}}/api/collections
Authorization: Bearer {{login.response.body.$.accessToken}}

### One collection (first of the list)
GET {{host}}/api/collections/{{collections.response.body.$[0].id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Items of that collection
GET {{host}}/api/collections/{{collections.response.body.$[0].id}}/items
Authorization: Bearer {{login.response.body.$.accessToken}}

### Mark as favourite
PUT {{host}}/api/collections/{{collections.response.body.$[0].id}}/favorite
Authorization: Bearer {{login.response.body.$.accessToken}}

### Remove favourite
DELETE {{host}}/api/collections/{{collections.response.body.$[0].id}}/favorite
Authorization: Bearer {{login.response.body.$.accessToken}}
